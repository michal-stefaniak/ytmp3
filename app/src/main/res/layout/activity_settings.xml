<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Audio quality" android:textColor="#AAAAAA" android:textSize="12sp" android:paddingBottom="6dp" />
        <Spinner android:id="@+id/spinner_bitrate" android:layout_width="match_parent" android:layout_height="52dp"
            android:background="#1A1A1A" android:popupBackground="#1A1A1A" />

        <View android:layout_width="match_parent" android:layout_height="20dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Concurrent downloads" android:textColor="#AAAAAA" android:textSize="12sp" android:paddingBottom="6dp" />
        <Spinner android:id="@+id/spinner_concurrency" android:layout_width="match_parent" android:layout_height="52dp"
            android:background="#1A1A1A" android:popupBackground="#1A1A1A" />

        <View android:layout_width="match_parent" android:layout_height="20dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Download folder" android:textColor="#AAAAAA" android:textSize="12sp" android:paddingBottom="6dp" />
        <Button android:id="@+id/btn_pick_dir" android:layout_width="match_parent" android:layout_height="52dp"
            android:backgroundTint="#1A1A1A" android:text="Choose folder" android:textColor="#FFFFFF" android:textAllCaps="false" />
        <TextView android:id="@+id/tv_dir_path" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="8dp" android:textColor="#666666" android:textSize="12sp"
            android:text="Default: app storage Music folder" />

        <View android:layout_width="match_parent" android:layout_height="28dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="DOWNLOAD BEHAVIOUR" android:textColor="#555555" android:textSize="11sp"
            android:letterSpacing="0.08" android:paddingBottom="4dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_wifi_only"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="WiFi only" android:textColor="#FFFFFF" android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_storage_warn"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Warn if storage below 200MB" android:textColor="#FFFFFF" android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_clipboard_sniff"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Detect YouTube URLs in clipboard" android:textColor="#FFFFFF" android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_dupe_check"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Warn before re-downloading" android:textColor="#FFFFFF" android:textSize="14sp" />

        <View android:layout_width="match_parent" android:layout_height="28dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="AUDIO PROCESSING" android:textColor="#555555" android:textSize="11sp"
            android:letterSpacing="0.08" android:paddingBottom="4dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_clean_title"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Clean up title (remove Official Video, HD, etc)" android:textColor="#FFFFFF" android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_normalise"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Normalize volume (loudnorm)" android:textColor="#FFFFFF" android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_sponsor_block"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Remove sponsor segments (SponsorBlock)" android:textColor="#FFFFFF" android:textSize="14sp" />

        <View android:layout_width="match_parent" android:layout_height="28dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ORGANISATION" android:textColor="#555555" android:textSize="11sp"
            android:letterSpacing="0.08" android:paddingBottom="4dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_auto_folder"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Group files by channel in subfolders" android:textColor="#FFFFFF" android:textSize="14sp" />

        <View android:layout_width="match_parent" android:layout_height="28dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="DISPLAY" android:textColor="#555555" android:textSize="11sp"
            android:letterSpacing="0.08" android:paddingBottom="4dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_show_speed"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:text="Show download speed and ETA" android:textColor="#FFFFFF" android:textSize="14sp" />

        <View android:layout_width="match_parent" android:layout_height="28dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="QUEUE" android:textColor="#555555" android:textSize="11sp"
            android:letterSpacing="0.08" android:paddingBottom="8dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:weightSum="2">
            <Button android:id="@+id/btn_export_queue"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#1A1A1A" android:text="Export queue" android:textColor="#FFFFFF"
                android:textAllCaps="false" />
            <Button android:id="@+id/btn_import_queue"
                android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1"
                android:backgroundTint="#1A1A1A" android:text="Import queue" android:textColor="#FFFFFF"
                android:textAllCaps="false" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="28dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="YT-DLP" android:textColor="#555555" android:textSize="11sp"
            android:letterSpacing="0.08" android:paddingBottom="8dp" />

        <Button android:id="@+id/btn_update" android:layout_width="match_parent" android:layout_height="52dp"
            android:backgroundTint="#CC0000" android:text="Update yt-dlp" android:textColor="#FFFFFF"
            android:textAllCaps="false" />

        <TextView android:id="@+id/tv_update_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingTop="10dp" android:textColor="#AAAAAA"
            android:textSize="13sp" android:visibility="gone" />

    </LinearLayout>

</ScrollView>
